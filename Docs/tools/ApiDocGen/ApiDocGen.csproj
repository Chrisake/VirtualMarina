<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Generates Docs/11-api-reference.md from the public surface of the VirtualMarina libraries (reflection) and their
    XML documentation files. Part of VirtualMarina.sln (solution folder "tools"), so every build and CI compile it
    under the same analyzers as the libraries. CI (.github/workflows/ci.yml, Windows job) regenerates it and fails when
    the committed file differs. To regenerate, run this project (on Windows) with no argument: it rewrites
    Docs/11-api-reference.md in place, wherever it is run from. An argument writes to that path instead.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\VirtualMarina.Core\VirtualMarina.Core.csproj" />
    <ProjectReference Include="..\..\..\src\VirtualMarina.Rendering.OpenGL\VirtualMarina.Rendering.OpenGL.csproj" />
    <ProjectReference Include="..\..\..\src\VirtualMarina.WinForms\VirtualMarina.WinForms.csproj" />
    <ProjectReference Include="..\..\..\src\VirtualMarina.Blazor\VirtualMarina.Blazor.csproj" />
  </ItemGroup>

</Project>
