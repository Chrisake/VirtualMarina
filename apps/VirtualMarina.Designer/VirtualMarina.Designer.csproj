<Project Sdk="Microsoft.NET.Sdk">

  <!--
    VirtualMarina Designer: the stand-alone tool marina operators use to draw their marina to scale and export it as a
    .marina.json design, which the host application then loads into a MarinaViewControl or <MarinaView>.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RootNamespace>VirtualMarina.Designer</RootNamespace>
    <AssemblyName>VirtualMarina.Designer</AssemblyName>
    <Product>VirtualMarina Designer</Product>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\VirtualMarina.WinForms\VirtualMarina.WinForms.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- One copy of the resource lookup, compiled into each assembly that shows text. See shared/ResourceText.cs. -->
    <Compile Include="..\..\shared\ResourceText.cs" Link="Resources\ResourceText.cs" />
  </ItemGroup>

</Project>
