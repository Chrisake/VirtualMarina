@namespace VirtualMarina.Designer.Blazor.Components
@inject IJSRuntime JS
@implements IDisposable

@*
    How the marina is drawn: water, light, colours and labels, changed live beside the view. Mirrors AppearancePanel.
    It redraws for its own changes and when asked to (Refresh), not every time the shell does: the shell redraws for
    every step of the designer, and none of those change a slider here.
*@
<div class="vm-appearance">
    <h2 class="vm-panel__title">@Strings.TitleLook</h2>
    <div class="vm-panel__hint">@Strings.LookHint</div>

    <div class="vm-card">
        <h3 class="vm-card__title">@Strings.CardWater</h3>
        @Percent(Strings.WaveHeight, (0, 60, Defaults.Water.WaveAmplitude * 100f), () => Water.WaveAmplitude * 100f, v => Water.WaveAmplitude = v / 100f, v => Meters(v / 100f))
        @Percent(Strings.WaveLength, (20, 300, Defaults.Water.WaveFrequency * 100f), () => Water.WaveFrequency * 100f, v => Water.WaveFrequency = v / 100f, v => Times(v / 100f))
        @Percent(Strings.WaveSpeed, (0, 300, Defaults.Water.WaveSpeed * 100f), () => Water.WaveSpeed * 100f, v => Water.WaveSpeed = v / 100f, v => v == 0 ? Strings.ValueStill : Times(v / 100f))
        @Percent(Strings.Reflections, (0, 100, Defaults.Water.SkyReflection * 100f), () => Water.SkyReflection * 100f, v => Water.SkyReflection = v / 100f, Percentage)
        @Percent(Strings.Ripples, (0, 200, Defaults.Water.Ripples * 100f), () => Water.Ripples * 100f, v => Water.Ripples = v / 100f, Percentage)
        @Percent(Strings.SunGlints, (0, 200, Defaults.Water.SunGlints * 100f), () => Water.SunGlints * 100f, v => Water.SunGlints = v / 100f, Percentage)
        @Percent(Strings.WaterArea, (800, 12000, Defaults.Water.Size), () => Water.Size, v => Water.Size = v, v => Strings.Format(Strings.ValueMetersWhole, v), Strings.WaterAreaTip)
        @Color(Strings.DeepWater, () => V(Water.DeepColor), c => Water.DeepColor = V3(c), V(Defaults.Water.DeepColor))
        @Color(Strings.ShallowWater, () => V(Water.ShallowColor), c => Water.ShallowColor = V3(c), V(Defaults.Water.ShallowColor))
    </div>

    <div class="vm-card">
        <h3 class="vm-card__title">@Strings.CardBoats</h3>
        @Percent(Strings.BoatMovement, (0, 300, Defaults.Water.BoatMotion * 100f), () => Water.BoatMotion * 100f, v => Water.BoatMotion = v / 100f, v => v == 0 ? Strings.ValueStill : Percentage(v))
        <div class="vm-hint">@Strings.BoatMovementHint</div>
    </div>

    <div class="vm-card">
        <h3 class="vm-card__title">@Strings.CardLight</h3>
        @Percent(Strings.SunDirection, (0, 359, 0f), () => SunAzimuth, v => Lighting.SetSunAngles(v, SunElevation), v => Strings.Format(Strings.ValueDegreesFromNorth, v))
        @Percent(Strings.SunHeight, (5, 89, 40f), () => SunElevation, v => Lighting.SetSunAngles(SunAzimuth, v), v => Strings.Format(Strings.ValueDegreesAboveHorizon, v))
        @Percent(Strings.Haze, (0, 100, Defaults.Lighting.FogDensity * 20000f), () => Lighting.FogDensity * 20000f, v => Lighting.FogDensity = v / 20000f, Percentage)
        @Color(Strings.Sky, () => V(Lighting.SkyColor), c => Lighting.SkyColor = V3(c), V(Defaults.Lighting.SkyColor))
        @Color(Strings.Horizon, () => V(Lighting.FogColor), c => Lighting.FogColor = V3(c), V(Defaults.Lighting.FogColor))
    </div>

    <div class="vm-card">
        <h3 class="vm-card__title">@Strings.CardBerthColors</h3>
        @Color(Strings.ColorFree, () => Status.FreeColor, c => Status.FreeColor = c, Defaults.Status.FreeColor)
        @Color(Strings.ColorOccupied, () => Status.OccupiedColor, c => Status.OccupiedColor = c, Defaults.Status.OccupiedColor)
        @Color(Strings.ColorReserved, () => Status.ReservedColor, c => Status.ReservedColor = c, Defaults.Status.ReservedColor)
        @Color(Strings.ColorOwnerAway, () => Status.TemporarilyFreeColor, c => Status.TemporarilyFreeColor = c, Defaults.Status.TemporarilyFreeColor)
        @Percent(Strings.PadStrength, (0, 100, Defaults.Status.PadOpacity * 100f), () => Status.PadOpacity * 100f, v => Status.PadOpacity = v / 100f, Percentage)
        @Check(Strings.ShowStatusBuoys, () => Status.ShowStatusMarkers, v => Status.ShowStatusMarkers = v)
    </div>

    <div class="vm-card">
        <h3 class="vm-card__title">@Strings.CardLand</h3>
        @Color(Strings.LandQuay, () => Land.QuayColor, c => Land.QuayColor = c, Defaults.Land.QuayColor)
        @Color(Strings.LandQuayWall, () => Land.QuayWallColor, c => Land.QuayWallColor = c, Defaults.Land.QuayWallColor)
        @Color(Strings.LandGrass, () => Land.GrassColor, c => Land.GrassColor = c, Defaults.Land.GrassColor)
        @Color(Strings.LandGrassBank, () => Land.GrassBankColor, c => Land.GrassBankColor = c, Defaults.Land.GrassBankColor)
        @Color(Strings.LandRock, () => Land.RockColor, c => Land.RockColor = c, Defaults.Land.RockColor)
        @Percent(Strings.LandRockVariation, (0, 50, Defaults.Land.RockColorVariation * 100f), () => Land.RockColorVariation * 100f, v => Land.RockColorVariation = v / 100f, Percentage, Strings.LandRockVariationTip)
        <h4 class="vm-section">@Strings.CardTrees</h4>
        @Color(Strings.LandFoliage, () => Land.FoliageColor, c => Land.FoliageColor = c, Defaults.Land.FoliageColor)
        @Color(Strings.LandConifer, () => Land.ConiferColor, c => Land.ConiferColor = c, Defaults.Land.ConiferColor)
        @Color(Strings.LandPalm, () => Land.PalmColor, c => Land.PalmColor = c, Defaults.Land.PalmColor)
        @Color(Strings.LandBlossom, () => Land.BlossomColor, c => Land.BlossomColor = c, Defaults.Land.BlossomColor)
        @Color(Strings.LandTrunk, () => Land.TrunkColor, c => Land.TrunkColor = c, Defaults.Land.TrunkColor)
        @Color(Strings.LandBuilding, () => Land.BuildingColor, c => Land.BuildingColor = c, Defaults.Land.BuildingColor)
        @Color(Strings.LandRoof, () => Land.RoofColor, c => Land.RoofColor = c, Defaults.Land.RoofColor)
        @Check(Strings.LandShowTrees, () => Land.ShowTrees, v => Land.ShowTrees = v)
    </div>

    <div class="vm-card">
        <h3 class="vm-card__title">@Strings.CardShadows</h3>
        @Check(Strings.ShadowsShow, () => Shadows.IsEnabled, v => Shadows.IsEnabled = v, Strings.ShadowsShowTip)
        @Percent(Strings.ShadowStrength, (0, 100, Defaults.Shadows.Strength * 100f), () => Shadows.Strength * 100f, v => Shadows.Strength = v / 100f, Percentage, Strings.ShadowStrengthTip)
        <div class="vm-hint">@Strings.ShadowHint</div>
    </div>

    <div class="vm-card">
        <h3 class="vm-card__title">@Strings.CardTraffic</h3>
        @Check(Strings.TrafficShow, () => Traffic.IsEnabled, v => SetTraffic(t => t with { IsEnabled = v }), Strings.TrafficShowTip)
        @Percent(Strings.TrafficClearance, (50, 1200, MarineTraffic.None.Clearance), () => Traffic.Clearance, v => SetTraffic(t => t with { Clearance = v }), v => Strings.Format(Strings.ValueMetersWhole, v), Strings.TrafficClearanceTip)
        @Percent(Strings.TrafficEdgeClearance, (50, 4000, MarineTraffic.None.EdgeClearance), () => Traffic.EdgeClearance, v => SetTraffic(t => t with { EdgeClearance = v }), v => Strings.Format(Strings.ValueMetersWhole, v), Strings.TrafficEdgeClearanceTip)
        @Percent(Strings.TrafficLanes, (1, MarineTraffic.LaneLimit, MarineTraffic.None.LaneCount), () => Traffic.LaneCount, v => SetTraffic(t => t with { LaneCount = (int)v }), v => Strings.Format(Strings.ValueLanes, v), Strings.TrafficLanesTip)
        @Percent(Strings.TrafficLaneSpacing, (40, 600, MarineTraffic.None.LaneSpacing), () => Traffic.LaneSpacing, v => SetTraffic(t => t with { LaneSpacing = v }), v => Strings.Format(Strings.ValueMetersWhole, v), Strings.TrafficLaneSpacingTip)
        @Percent(Strings.TrafficMaximum, (1, MarineTraffic.VesselLimit, MarineTraffic.None.MaximumVessels), () => Traffic.MaximumVessels, v => SetTraffic(t => t with { MaximumVessels = (int)v }), v => Strings.Format(Strings.ValueVessels, v), Strings.TrafficMaximumTip)
        @Percent(Strings.TrafficSpeed, (10, 400, MarineTraffic.None.SpeedPercent), () => Traffic.SpeedPercent, v => SetTraffic(t => t with { SpeedPercent = v }), Percentage, Strings.TrafficSpeedTip)
        @Percent(Strings.TrafficSpawnDelay, (1, 180, MarineTraffic.None.SpawnDelaySeconds), () => Traffic.SpawnDelaySeconds, v => SetTraffic(t => t with { SpawnDelaySeconds = v }), v => Strings.Format(Strings.ValueSeconds, v), Strings.TrafficSpawnDelayTip)
        @Check(Strings.TrafficShowLanes, () => Marina.ShowTrafficLanes, v => Changed(() => Marina.ShowTrafficLanes = v, saved: false), Strings.TrafficShowLanesTip)
        <div class="vm-hint">@Strings.TrafficHint</div>
        <div class="vm-hint">@TrafficLanesNote()</div>
    </div>

    <div class="vm-card">
        <h3 class="vm-card__title">@Strings.CardLabels</h3>
        <div class="vm-grid">
            <label class="vm-grid__label" for="vm-label-font" title="@Strings.LabelFontTip">@Strings.LabelFont</label>
            <select id="vm-label-font" value="@_fontSelection" disabled="@_capturing" @onchange="OnFontChanged">
                <option value="">@Strings.FontBuiltIn</option>
                @if (StoredOnlyFamily() is { } stored) { <option value="@stored">@Strings.Format(Strings.FontStoredInDesign, stored)</option> }
                @foreach (var family in _fontFamilies) { <option value="@family">@family</option> }
            </select>
        </div>
        <label class="vm-check" style="margin-top:6px" title="@Strings.LabelBoldTip"><input type="checkbox" checked="@_bold" disabled="@_capturing" @onchange="OnBoldChanged" /> @Strings.LabelBold</label>
        @if (_capturing) { <div class="vm-hint" role="status">@Strings.Format(Strings.FontCapturing, _fontSelection)</div> }
        @Color(Strings.LabelColorNormal, () => Labels.Color, c => Labels.Color = c, Defaults.Labels.Color)
        @Color(Strings.LabelColorAshore, () => Labels.AshoreColor, c => Labels.AshoreColor = c, Defaults.Labels.AshoreColor, Strings.LabelColorAshoreTip)
        @Color(Strings.LabelColorHighlight, () => Labels.HighlightColor, c => Labels.HighlightColor = c, Defaults.Labels.HighlightColor)
        @Color(Strings.LabelColorDisabled, () => Labels.DisabledColor, c => Labels.DisabledColor = c, Defaults.Labels.DisabledColor)
    </div>

    <div class="vm-card">
        <h3 class="vm-card__title">@Strings.CardPreview</h3>
        <div class="vm-grid">
            <label class="vm-grid__label" for="vm-preview-fill" title="@Strings.PreviewFillTip">@Strings.PreviewFill</label>
            <div class="vm-slider">
                <input id="vm-preview-fill" type="range" min="0" max="100" step="1" value="@_fill" aria-valuetext="@Strings.Format(Strings.Percent, _fill)" @oninput="OnFill" />
                <span class="vm-slider__value" aria-hidden="true">@Strings.Format(Strings.Percent, _fill)</span>
            </div>
        </div>
        <div class="vm-row">
            <button class="vm-btn vm-btn--primary" @onclick="FillWithBoats">@Strings.PreviewAdd</button>
            <button class="vm-btn" @onclick="() => ClearBoats()">@Strings.PreviewClear</button>
        </div>
        <div class="vm-hint">@Strings.PreviewHint</div>
    </div>

    <div class="vm-card">
        <h3 class="vm-card__title">@Strings.AppearanceReset</h3>
        <div class="vm-row"><button class="vm-btn" @onclick="ResetAllAsync">@Strings.AppearanceReset</button></div>
    </div>
</div>

@code {
    private static readonly MarinaStyle Defaults = new();

    private MarinaVisualizer? _subscribed;
    private readonly Random _random = new();
    private int _fill = 60;
    private IReadOnlyList<string> _fontFamilies = Array.Empty<string>();
    private string _fontSelection = string.Empty;
    private bool _bold;
    private bool _capturing;
    private bool _initialized;

    /// <summary>Fonts already captured, by family and weight: capturing traces every glyph, so each is done once.</summary>
    private readonly Dictionary<(string Family, bool Bold), LabelFontDefinition?> _captured = [];

    /// <summary>The marina whose look is being changed. Required.</summary>
    [Parameter, EditorRequired] public MarinaVisualizer Marina { get; set; } = default!;

    /// <summary>Where to note what happened, for the activity log.</summary>
    [Parameter] public EventCallback<string> Log { get; set; }

    /// <summary>Raised after every change to what the design saves: the style, the traffic, the label font.</summary>
    [Parameter] public EventCallback StyleChanged { get; set; }

    /// <summary>Asks before everything is put back to its defaults. Required.</summary>
    [Parameter, EditorRequired] public IDesignerDialogs Dialogs { get; set; } = default!;

    private WaterSettings Water => Marina.Style.Water;
    private LightingSettings Lighting => Marina.Style.Lighting;
    private LandStyle Land => Marina.Style.Land;
    private MarineTraffic Traffic => Marina.MarineTraffic;
    private ShadowStyle Shadows => Marina.Style.Shadows;
    private StatusColorScheme Status => Marina.Style.Status;
    private LabelStyle Labels => Marina.Style.Labels;

    private float SunAzimuth
    {
        get
        {
            var sun = Lighting.SunDirection;
            var degrees = MathF.Atan2(sun.X, sun.Z) * 180f / MathF.PI;
            return degrees < 0f ? degrees + 360f : degrees;
        }
    }

    private float SunElevation => MathF.Asin(Math.Clamp(Lighting.SunDirection.Y, -1f, 1f)) * 180f / MathF.PI;

    private IJSInProcessRuntime InProcess => (IJSInProcessRuntime)JS;

    /// <summary>
    /// Takes the parameters without redrawing when they are the ones it has: the shell passes the same marina on every
    /// one of its renders. A different marina redraws, as does <see cref="Refresh"/>.
    /// </summary>
    public override Task SetParametersAsync(ParameterView parameters)
    {
        var previous = Marina;
        parameters.SetParameterProperties(this);
        if (_initialized && ReferenceEquals(previous, Marina)) return Task.CompletedTask;
        _initialized = true;
        return base.SetParametersAsync(ParameterView.Empty);
    }

    protected override void OnParametersSet()
    {
        if (Marina is null) throw new InvalidOperationException($"{nameof(Appearance)} requires the {nameof(Marina)} parameter.");
        if (ReferenceEquals(_subscribed, Marina)) return;
        _subscribed = Marina;
        SyncFont();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender || _fontFamilies.Count > 0) return;
        _fontFamilies = BrowserFonts.InstalledFamilies(InProcess);
        SyncFont();
        StateHasChanged();
    }

    /// <summary>Reads every setting back out of the marina, e.g. after New or Open replaced the style.</summary>
    public void Refresh()
    {
        SyncFont();
        StateHasChanged();
    }

    public void Dispose() => _subscribed = null;

    // ---- Row helpers ----------------------------------------------------------------------------

    private RenderFragment Percent(string label, (int Min, int Max, float Default) range, Func<float> read, Action<float> write, Func<int, string> format, string? tooltip = null) => __builder =>
    {
        var (min, max, fallback) = range;
        var value = Clamp(read(), min, max);
        <div class="vm-grid">
            <span class="vm-grid__label" title="@tooltip" aria-hidden="true">@label</span>
            <div class="vm-with-reset">
                <div class="vm-slider">
                    <input type="range" min="@min" max="@max" step="1" value="@value" aria-label="@label" aria-valuetext="@format(value)" title="@tooltip"
                           @oninput="e => Changed(() => write(ToInt(e, value)))" />
                    <span class="vm-slider__value" aria-hidden="true">@format(value)</span>
                </div>
                <button class="vm-reset" title="@Strings.ResetTip" aria-label="@($"{Strings.ResetTip}: {label}")" @onclick="() => Changed(() => write(Clamp(fallback, min, max)))">@Strings.ResetGlyph</button>
            </div>
        </div>
    };

    private RenderFragment Color(string label, Func<ColorRgba> read, Action<ColorRgba> write, ColorRgba fallback, string? tooltip = null) => __builder =>
    {
        <div class="vm-grid">
            <span class="vm-grid__label" title="@tooltip" aria-hidden="true">@label</span>
            <div class="vm-with-reset">
                <input class="vm-swatch" type="color" value="@Hex(read())" aria-label="@label" title="@tooltip"
                       @onchange="e => Changed(() => write(ColorRgba.FromHex(e.Value?.ToString() ?? Hex(fallback))))" />
                <button class="vm-reset" title="@Strings.ResetTip" aria-label="@($"{Strings.ResetTip}: {label}")" @onclick="() => Changed(() => write(fallback))">@Strings.ResetGlyph</button>
            </div>
        </div>
    };

    private RenderFragment Check(string label, Func<bool> read, Action<bool> write, string? tooltip = null) => __builder =>
    {
        <label class="vm-check" style="margin-top:6px" title="@tooltip"><input type="checkbox" checked="@read()" @onchange="e => Changed(() => write(e.Value is true))" /> @label</label>
    };

    // ---- Traffic --------------------------------------------------------------------------------

    private void SetTraffic(Func<MarineTraffic, MarineTraffic> change) => Changed(() => Marina.SetMarineTraffic(change(Marina.MarineTraffic)));

    private string TrafficLanesNote()
    {
        if (!Traffic.IsEnabled) return string.Empty;
        var lanes = Marina.TrafficLanes;
        if (lanes.Count == 0) return Strings.TrafficNoRoom;
        var (min, max) = Marina.GetLayout().ComputeBounds();
        var center = (min + max) * 0.5f;
        return Strings.Format(Strings.TrafficPasses, lanes.Count, (int)MathF.Round(lanes.Min(lane => lane.DistanceTo(center))));
    }

    // ---- Labels / fonts -------------------------------------------------------------------------

    private void SyncFont()
    {
        _fontSelection = Labels.Font is null ? string.Empty : FamilyOf(Labels.Font.Name);
        _bold = Labels.Font?.IsBold ?? Labels.FontFamily == LabelFont.Bold;
    }

    /// <summary>
    /// The family of a font the design carries its own letters for but this browser does not have, so the list
    /// can still show what the labels are drawn in instead of going blank. Null when there is no such font.
    /// </summary>
    private string? StoredOnlyFamily() =>
        _fontSelection.Length == 0 || _fontFamilies.Contains(_fontSelection, StringComparer.Ordinal) ? null : _fontSelection;

    private Task OnFontChanged(ChangeEventArgs e)
    {
        _fontSelection = e.Value?.ToString() ?? string.Empty;
        return UseFontAsync();
    }

    private Task OnBoldChanged(ChangeEventArgs e)
    {
        _bold = e.Value is true;
        return UseFontAsync();
    }

    /// <summary>
    /// Puts the chosen font on the labels. A font not captured before is traced glyph by glyph in the browser, which
    /// takes a moment, so the panel first says so and lets the browser draw that before the work starts.
    /// </summary>
    private async Task UseFontAsync()
    {
        var family = string.IsNullOrEmpty(_fontSelection) ? null : _fontSelection;
        var bold = _bold;
        LabelFontDefinition? font = null;
        if (family is not null && !_captured.TryGetValue((family, bold), out font))
        {
            _capturing = true;
            StateHasChanged();

            // A timer, not a yield: the browser only paints the "Reading the letter shapes" line between tasks.
            await Task.Delay(30);
            font = BrowserFonts.Capture(InProcess, family, bold);
            _captured[(family, bold)] = font;
            _capturing = false;
        }

        Changed(() =>
        {
            Labels.Font = font;
            Labels.FontFamily = bold ? LabelFont.Bold : LabelFont.Regular;
            if (family is not null && font is null) _fontSelection = string.Empty;
        });
    }

    private static string FamilyOf(string fontName) =>
        fontName.EndsWith(" Bold", StringComparison.Ordinal) ? fontName[..^5] : fontName;

    // ---- Preview fleet --------------------------------------------------------------------------

    private async Task FillWithBoats()
    {
        ClearBoats(log: false);

        var berths = Marina.GetBerths();
        var wanted = (int)MathF.Round(berths.Count * _fill / 100f);
        if (wanted == 0)
        {
            await Log.InvokeAsync(Strings.LogPreviewCleared);
            return;
        }

        var plan = PreviewFleet.Plan(berths, wanted, _random);
        var filled = 0;
        using (Marina.BeginUpdate())
        {
            foreach (var mooring in plan)
            {
                if (mooring.BerthIds.Count == 1) Marina.AssignBoat(mooring.BerthIds[0], mooring.Boat);
                else Marina.AssignBoatToBerths(mooring.BerthIds, mooring.Boat, style: mooring.Style);
                filled += mooring.BerthIds.Count;
            }
        }

        await Log.InvokeAsync(Strings.Format(Strings.LogPreviewBoats, filled, berths.Count));
    }

    private void ClearBoats(bool log = true)
    {
        using (Marina.BeginUpdate())
        {
            foreach (var berth in Marina.GetMultiBerths()) Marina.ReleaseMultiBerth(berth.Id);
            foreach (var berth in Marina.GetBerths().Where(b => b.Boat is not null))
            {
                Marina.SetBerthStatus(berth.Id, BerthStatus.Free);
            }
        }

        if (log) _ = Log.InvokeAsync(Strings.LogPreviewCleared);
    }

    /// <summary>Puts every look setting back, after asking: there is no undo for it.</summary>
    private async Task ResetAllAsync()
    {
        if (!await Dialogs.ConfirmAsync(Strings.ConfirmResetAppearanceTitle, Strings.ConfirmResetAppearance)) return;
        Marina.Style = new MarinaStyle();
        Marina.SetMarineTraffic(MarineTraffic.None);
        SyncFont();
        StateHasChanged();
        await StyleChanged.InvokeAsync();
    }

    // ---- Plumbing -------------------------------------------------------------------------------

    /// <summary>
    /// Applies a change and reports it so the design counts as changed. The marina notices a change to its style by
    /// itself, so nothing has to be redrawn here but the panel.
    /// </summary>
    /// <param name="change">The change.</param>
    /// <param name="saved">False for a setting the design file does not keep (the lanes are a designer aid).</param>
    private void Changed(Action change, bool saved = true)
    {
        change();
        StateHasChanged();
        if (saved) _ = StyleChanged.InvokeAsync();
    }

    private void OnFill(ChangeEventArgs e) => _fill = ToInt(e, _fill);

    private static int Clamp(float value, int min, int max) => Math.Clamp((int)MathF.Round(value), min, max);

    private static int ToInt(ChangeEventArgs e, int fallback) =>
        int.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var value) ? value : fallback;

    private static string Percentage(int value) => Strings.Format(Strings.Percent, value);
    private static string Meters(float value) => Strings.Format(Strings.ValueMeters, value);
    private static string Times(float value) => Strings.Format(Strings.ValueTimes, value);

    private static string Hex(ColorRgba color) =>
        string.Create(CultureInfo.InvariantCulture, $"#{Byte(color.R):x2}{Byte(color.G):x2}{Byte(color.B):x2}");

    private static int Byte(float value) => Math.Clamp((int)MathF.Round(value * 255f), 0, 255);

    private static ColorRgba V(Vector3 color) => new(color.X, color.Y, color.Z);
    private static Vector3 V3(ColorRgba color) => new(color.R, color.G, color.B);
}
