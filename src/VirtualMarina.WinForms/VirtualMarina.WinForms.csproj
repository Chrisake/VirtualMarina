<Project Sdk="Microsoft.NET.Sdk">

  <!-- WinForms host control: embeds an OpenGL surface and wires it to MarinaVisualizer. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>VirtualMarina.WinForms</RootNamespace>
    <Description>Windows Forms host for VirtualMarina: the MarinaViewControl and MarinaDesignerPanel controls on an OpenGL surface.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The control's tests reach its internals directly rather than through reflection. -->
    <InternalsVisibleTo Include="VirtualMarina.WinForms.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenTK.GLControl" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VirtualMarina.Core\VirtualMarina.Core.csproj" />
    <ProjectReference Include="..\VirtualMarina.Rendering.OpenGL\VirtualMarina.Rendering.OpenGL.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- One copy of the resource lookup, compiled into each assembly that shows text. See shared/ResourceText.cs. -->
    <Compile Include="..\..\shared\ResourceText.cs" Link="Resources\ResourceText.cs" />
  </ItemGroup>

</Project>
