<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Platform-neutral core: domain model, public API, events, camera, input, picking,
    procedural geometry and renderer abstractions. No graphics/UI dependencies, so it
    runs unchanged on desktop CLR and in the browser (WebAssembly).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>VirtualMarina.Core</RootNamespace>
    <IsTrimmable>true</IsTrimmable>
    <!-- XML documentation is generated for all libraries by src/Directory.Build.props. -->
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VirtualMarina.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- One copy of the resource lookup, compiled into each assembly that shows text. See shared/ResourceText.cs. -->
    <Compile Include="..\..\shared\ResourceText.cs" Link="Resources\ResourceText.cs" />
  </ItemGroup>

</Project>
