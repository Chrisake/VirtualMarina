<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Platform-neutral core: domain model, public API, events, camera, input, picking,
    procedural geometry and renderer abstractions. No graphics/UI dependencies, so it
    runs unchanged on desktop CLR and in the browser (WebAssembly).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>VirtualMarina.Core</RootNamespace>
    <Description>The platform-neutral core of VirtualMarina: marina domain model, public API and events, camera, input, picking, procedural geometry, the .marina.json format and the renderer abstraction. Runs on the desktop CLR and in WebAssembly.</Description>
    <!--
      Safe to trim and to compile ahead of time: the Blazor host ships it to the browser trimmed. The trim and AOT
      analyzers run on every build, so the few members that need reflection or runtime code generation (the
      host-data extension helpers of MarinaDocument) have to say so with [RequiresUnreferencedCode] and
      [RequiresDynamicCode].
    -->
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- XML documentation is generated for all libraries by src/Directory.Build.props. -->
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VirtualMarina.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- One copy of the resource lookup, compiled into each assembly that shows text. See shared/ResourceText.cs. -->
    <Compile Include="..\..\shared\ResourceText.cs" Link="Resources\ResourceText.cs" />
  </ItemGroup>

</Project>
