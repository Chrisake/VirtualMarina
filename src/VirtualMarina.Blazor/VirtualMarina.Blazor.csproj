<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    Browser host: a Blazor component plus a WebGL 2 implementation of ISceneRenderer.
    The same VirtualMarina.Core assembly runs inside WebAssembly; only this thin layer is web-specific.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>VirtualMarina.Blazor</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.0.31" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VirtualMarina.Core\VirtualMarina.Core.csproj" />
  </ItemGroup>

</Project>
