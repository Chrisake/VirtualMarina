<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    Browser host: a Blazor component plus a WebGL 2 implementation of ISceneRenderer.
    The same VirtualMarina.Core assembly runs inside WebAssembly; only this thin layer is web-specific.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>VirtualMarina.Blazor</RootNamespace>
    <Description>Blazor WebAssembly host for VirtualMarina: the MarinaView component and a WebGL 2 scene renderer.</Description>
    <PackageTags>$(PackageTags);webassembly</PackageTags>
    <!--
      Not yet marked IsTrimmable/IsAotCompatible: the trim analyzer reports IL2026 on the generic
      IJSInProcessObjectReference.Invoke<T> calls in MarinaView.razor.cs and WebGlSceneRenderer.cs. They marshal only
      primitives and arrays of them, but each needs its justification recorded in the code before the flags go on.
    -->
  </PropertyGroup>

  <ItemGroup>
    <!-- The component's tests reach its internals directly rather than through reflection. -->
    <InternalsVisibleTo Include="VirtualMarina.Blazor.Tests" />
  </ItemGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VirtualMarina.Core\VirtualMarina.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- One copy of the resource lookup, compiled into each assembly that shows text. See shared/ResourceText.cs. -->
    <Compile Include="..\..\shared\ResourceText.cs" Link="Resources\ResourceText.cs" />
  </ItemGroup>

</Project>
