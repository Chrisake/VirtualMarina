<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests for the WinForms host control. Windows-only, so kept apart from the cross-platform Core tests.
    The test framework, runner and coverage come from tests/Directory.Build.props.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\VirtualMarina.WinForms\VirtualMarina.WinForms.csproj" />
    <!-- The API surface writer and the baseline check are shared with the core tests rather than copied. -->
    <ProjectReference Include="..\VirtualMarina.TestSupport\VirtualMarina.TestSupport.csproj" />
  </ItemGroup>

</Project>
