<Project Sdk="Microsoft.NET.Sdk">

  <!-- The test framework, runner and coverage come from tests/Directory.Build.props. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!-- Property-based tests: random inputs, shrunk to the smallest failing case. -->
    <PackageReference Include="CsCheck" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\VirtualMarina.Core\VirtualMarina.Core.csproj" />
    <!-- Referenced so the published surface of the OpenGL renderer is covered by PublicApiTests. -->
    <ProjectReference Include="..\..\src\VirtualMarina.Rendering.OpenGL\VirtualMarina.Rendering.OpenGL.csproj" />
    <ProjectReference Include="..\..\samples\VirtualMarina.SampleData\VirtualMarina.SampleData.csproj" />
    <ProjectReference Include="..\VirtualMarina.TestSupport\VirtualMarina.TestSupport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Golden files: saved designs of every format version, which must keep loading. -->
    <None Include="Fixtures\**\*.marina.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
