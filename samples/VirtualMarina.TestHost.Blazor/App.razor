@inject IJSRuntime JS
@implements IDisposable

<PageTitle>VirtualMarina – Blazor WebAssembly Test Host</PageTitle>

<div class="shell">
    <div class="viewport">
        <MarinaView @ref="_view" Marina="_marina" OnRendererReady="OnRendererReady" OnRendererError="OnRendererError" />
    </div>

    <div class="statusbar">
        <span>@_rendererInfo</span>
        <span>@_hoverText</span>
        <span>Click: tooltip · Ctrl/Shift+click: multi-select · Right-click: actions · Left-drag: pan · Right-drag: orbit · Wheel: zoom · Double-click: focus · Esc: close/clear</span>
    </div>

    <aside class="side">
        <div class="tabs">
            <button class="@(_designerTab ? null : "active")" @onclick="() => ShowDesigner(false)">Berth desk</button>
            <button class="@(_designerTab ? "active" : null)" @onclick="() => ShowDesigner(true)">Designer</button>
        </div>

        @if (_designerTab)
        {
            <fieldset>
                <legend>Marina</legend>
                <div class="buttons">
                    <button @onclick="StartEmptyMarina">New empty marina</button>
                    <button @onclick="ReloadLayout">Load sample marina</button>
                    <button @onclick="ToggleExport">@(_export is null ? "Export objects" : "Hide export")</button>
                    <button @onclick="DownloadDesign">Save design</button>
                </div>
                @* A design drawn in the VirtualMarina Designer: layout, look, motion, labels and camera in one file. *@
                <div class="buttons" style="margin-top:6px">
                    <InputFile OnChange="LoadDesignAsync" accept=".json,application/json" />
                </div>
                @if (_designError is not null)
                {
                    <div class="note" style="color:#c62f28">@_designError</div>
                }
                @if (_export is not null)
                {
                    <pre class="details export">@_export</pre>
                }
            </fieldset>

            @* The library's ready-made designer panel: tools, land/pier/berth settings and the reference image. *@
            <MarinaDesignerPanel Marina="_marina" View="_view" />
        }
        else
        {
        <fieldset>
            <legend>Selection</legend>
            <pre class="details">@SelectionDetails()</pre>
            <div class="buttons">
                <button class="free" @onclick="() => SetSelectedStatus(BerthStatus.Free)">Free</button>
                <button class="occupied" @onclick="() => SetSelectedStatus(BerthStatus.Occupied)">Occupied</button>
                <button class="reserved" @onclick="() => SetSelectedStatus(BerthStatus.Reserved)">Reserved</button>
                <button class="temporarily-free" @onclick="() => SetSelectedStatus(BerthStatus.TemporarilyFree)">Temp. free</button>
                <button @onclick="() => _marina.ShowActions()">Actions…</button>
                <button @onclick="FocusSelected">Focus (top down)</button>
                <button @onclick="SelectWholePier">Select whole pier / land area</button>
                <button @onclick="() => _marina.ClearSelection()">Clear</button>
            </div>
            <div class="buttons">
                <button @onclick="() => _marina.SetBerthFlags(SelectedIds(), readOnly: true)">Read-only</button>
                <button @onclick="() => _marina.SetBerthFlags(SelectedIds(), disabled: true)">Disable</button>
                <button @onclick="() => _marina.SetBerthFlags(SelectedIds(), visible: false)">Hide</button>
                <button @onclick="() => _erp.ResetAllFlags()">Reset all flags</button>
            </div>
        </fieldset>

        <fieldset>
            <legend>Status filter</legend>
            <label class="check" style="color:var(--free)"><input type="checkbox" checked="@_showFree" @onchange="e => ToggleFilter(ref _showFree, e)" /> Free</label>
            <label class="check" style="color:var(--occupied)"><input type="checkbox" checked="@_showOccupied" @onchange="e => ToggleFilter(ref _showOccupied, e)" /> Occupied</label>
            <label class="check" style="color:var(--reserved)"><input type="checkbox" checked="@_showReserved" @onchange="e => ToggleFilter(ref _showReserved, e)" /> Reserved</label>
            <label class="check" style="color:var(--temporarily-free)"><input type="checkbox" checked="@_showTemporarilyFree" @onchange="e => ToggleFilter(ref _showTemporarilyFree, e)" /> Temp. free</label>
            <div class="buttons"><button @onclick="ShowAll">Show all</button></div>
        </fieldset>

        <fieldset>
            <legend>Berth labels on the water</legend>
            <select value="@_marina.BerthLabelMode" @onchange="ApplyLabelMode">
                @foreach (var mode in Enum.GetValues<BerthLabelMode>())
                {
                    <option value="@mode">@mode.GetDisplayName()</option>
                }
            </select>
        </fieldset>

        <fieldset>
            <legend>Camera</legend>
            <select value="@_selectedPreset" @onchange="ApplyPreset">
                @foreach (var preset in _marina.CameraPresets.Where(p => p.IsEnabled))
                {
                    <option value="@PresetValue(preset)" title="@preset.Description">@preset.Name</option>
                }
            </select>
            <div class="buttons"><button @onclick="ResetView">Reset view</button></div>
        </fieldset>

        <fieldset>
            <legend>Space management</legend>
            <div class="buttons">
                <button @onclick="AddGuestBerth">Add guest berth (D)</button>
                <button @onclick="RemoveSelected">Remove selected</button>
                <button @onclick="RunBatch">Batch: 15 random</button>
                <button @onclick="() => _erp.MoorYachtAlongside(SelectedIds())">Moor yacht alongside selection</button>
                <button @onclick="ReleaseSelectedBerth">Release berth</button>
                <button @onclick="ReloadLayout">Reload layout</button>
                <button @onclick="ToggleReservedColor">Toggle blue/purple</button>
            </div>
        </fieldset>

        }

        <fieldset class="stats">
            <legend>Statistics</legend>
            <span>@_stats.TotalBerths berths</span>
            <span style="color:var(--free)">Free @_stats.Free</span>
            <span style="color:var(--occupied)">Occupied @_stats.Occupied</span>
            <span style="color:var(--reserved)">Reserved @_stats.Reserved</span>
            <span style="color:var(--temporarily-free)">Temp. free @_stats.TemporarilyFree</span>
            <span>Occupancy @_stats.OccupancyRate.ToString("P0")</span>
        </fieldset>

        <fieldset>
            <legend>Events raised by the library</legend>
            <ul class="log">
                @foreach (var entry in _log)
                {
                    <li>@entry</li>
                }
            </ul>
        </fieldset>
    </aside>
</div>

@code {
    // Every focus in the test host (buttons, actions, double-click) looks straight down.
    private readonly MarinaVisualizer _marina = new() { DefaultFocusAngle = CameraAngle.TopDown };
    private readonly Random _rng = new(7);
    private readonly LinkedList<string> _log = new();
    private SampleErpIntegration _erp = default!;
    private MarinaView? _view;
    private bool _designerTab;
    private string? _designError;

    // The design file last loaded, kept so saving writes back what this host does not understand (another
    // application's sections, a description, newer properties) instead of dropping it. Null for a marina made here.
    private MarinaDocument? _document;
    private string? _export;
    private MarinaStatistics _stats = new(0, 0, 0, 0);
    private string _rendererInfo = "Starting WebGL…";
    private string _hoverText = string.Empty;
    private string _selectedPreset = OverviewValue;
    private bool _showFree = true;
    private bool _showOccupied = true;
    private bool _showReserved = true;
    private bool _showTemporarilyFree = true;

    protected override void OnInitialized()
    {
        _marina.BerthClicked += OnBerthClicked;
        _marina.SelectionChanged += OnSelectionChanged;
        _marina.SelectionCleared += OnSelectionCleared;
        _marina.BerthHoverChanged += OnBerthHoverChanged;
        _marina.BerthStatusChanged += OnBerthStatusChanged;
        _marina.LayoutChanged += OnLayoutChanged;
        _marina.CameraPresetsChanged += OnCameraPresetsChanged;

        // Fills tooltips and actions, runs actions, and stores ERP objects in Berth.ExternalData.
        _erp = new SampleErpIntegration(_marina, _rng, Log);

        // Everything the designer does is reported to the host.
        var designer = _marina.Designer;
        designer.ActiveChanged += OnDesignerActiveChanged;
        designer.ToolChanged += OnDesignToolChanged;
        designer.DraftChanged += OnDraftChanged;
        designer.ElementCreated += OnElementCreated;
        designer.ElementErased += OnElementErased;
        designer.ScaleLineDrawn += OnScaleLineDrawn;
        designer.ReferenceImageChanged += OnReferenceImageChanged;

        _marina.InitializeLayout(MockMarinaFactory.CreateSampleMarina());
    }

    public void Dispose()
    {
        _erp.Dispose();
        _marina.BerthClicked -= OnBerthClicked;
        _marina.SelectionChanged -= OnSelectionChanged;
        _marina.SelectionCleared -= OnSelectionCleared;
        _marina.BerthHoverChanged -= OnBerthHoverChanged;
        _marina.BerthStatusChanged -= OnBerthStatusChanged;
        _marina.LayoutChanged -= OnLayoutChanged;
        _marina.CameraPresetsChanged -= OnCameraPresetsChanged;
        var designer = _marina.Designer;
        designer.ActiveChanged -= OnDesignerActiveChanged;
        designer.ToolChanged -= OnDesignToolChanged;
        designer.DraftChanged -= OnDraftChanged;
        designer.ElementCreated -= OnElementCreated;
        designer.ElementErased -= OnElementErased;
        designer.ScaleLineDrawn -= OnScaleLineDrawn;
        designer.ReferenceImageChanged -= OnReferenceImageChanged;
    }

    // ---- Designer ------------------------------------------------------------------------------

    /// <summary>Loads a .marina.json design: one file brings the layout, the look and motion, the labels and the camera.</summary>
    private async Task LoadDesignAsync(InputFileChangeEventArgs e)
    {
        _designError = null;
        try
        {
            await using var stream = e.File.OpenReadStream(32 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            var document = MarinaDocument.Parse(await reader.ReadToEndAsync());
            document.ApplyTo(_marina);
            _document = document;
            Log($"Loaded design   {e.File.Name}: {document.Layout.Berths.Count} berths, format {document.Version}");
        }
        catch (Exception ex) when (ex is MarinaFormatException or MarinaLayoutException or IOException)
        {
            _designError = ex.Message;
        }
    }

    /// <summary>
    /// Offers the marina on screen as a .marina.json file the designer (or another host) can open. A design that was
    /// loaded is brought up to date with UpdateFrom, so what it carried that this host does not know about survives;
    /// a marina started here is written fresh with FromVisualizer.
    /// </summary>
    private async Task DownloadDesign()
    {
        const string generator = "VirtualMarina Blazor test host";
        if (_document is null) _document = MarinaDocument.FromVisualizer(_marina, generator);
        else _document.UpdateFrom(_marina, generator);
        var json = _document.ToJson();
        await JS.InvokeVoidAsync("vmDownloadText", Sanitize(_marina.MarinaName) + MarinaDocument.FileExtension, json);
        Log($"Saved design    {_marina.GetBerths().Count} berths");
    }

    private static string Sanitize(string name) =>
        new string(name.Select(c => char.IsLetterOrDigit(c) || c is '-' or '_' ? c : '-').ToArray()).Trim('-') is { Length: > 0 } cleaned ? cleaned : "marina";

    private void ShowDesigner(bool show)
    {
        _designerTab = show;
        _marina.Designer.IsActive = show;
    }

    private void StartEmptyMarina()
    {
        _export = null;
        _document = null;
        _marina.InitializeLayout(new MarinaLayout { Name = "New marina" });
        _marina.Designer.IsActive = true;
        _marina.Designer.Tool = DesignTool.DrawLandArea;
        _marina.Designer.ViewTopDown(immediate: true);
    }

    /// <summary>What an ERP would store: every element of the marina, as returned by ExportObjects.</summary>
    private void ToggleExport()
    {
        if (_export is not null)
        {
            _export = null;
            return;
        }

        var objects = _marina.ExportObjects();
        var text = new System.Text.StringBuilder($"{objects.Length} objects\n");
        foreach (var element in objects)
        {
            text.AppendLine(element switch
            {
                LandArea l => $"LandArea {l.Id} {l.Kind} h={Fmt(l.Height)} [{string.Join("; ", l.Points.Select(Fmt))}]",
                Pier d => $"Pier {d.Id} {d.Type} start {Fmt(d.Start)} heading {Fmt(d.HeadingDegrees)}° {Fmt(d.Length)}x{Fmt(d.Width)} m {d.BerthingSides}",
                Divider v => $"Divider {v.Id} {v.Type} pier {v.PierId} start {Fmt(v.Start)} {Fmt(v.Length)} m",
                Berth s => $"Berth {s.Id} {(s.PierId is null ? "land " + s.LandAreaId : "pier " + s.PierId)} center {Fmt(s.Center)} {Fmt(s.Width)}x{Fmt(s.Length)} m depth {(s.MaxDraft is { } draft ? Fmt(draft) : "-")} {s.Status}",
                MultiBerth b => $"Berth {b.Id} {string.Join(",", b.BerthIds)} {b.Boat.Name}",
                _ => element.ToString(),
            });
        }

        _export = text.ToString();
    }

    private static string Fmt(float value) => value.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);

    private static string Fmt(System.Numerics.Vector2 p) => $"({Fmt(p.X)}, {Fmt(p.Y)})";

    private void OnDesignerActiveChanged(object? sender, EventArgs e)
    {
        _designerTab = _marina.Designer.IsActive;
        Log($"Designer        {(_marina.Designer.IsActive ? "on" : "off")}");
    }

    private void OnDesignToolChanged(object? sender, DesignToolChangedEventArgs e) => Log($"DesignTool      {e.Current}");

    private void OnDraftChanged(object? sender, DesignDraftChangedEventArgs e) =>
        Log($"Drawing         {e.Tool} {e.Change} ({e.Points.Count} pts{(e.Points.Count > 0 ? ", last " + Fmt(e.Points[^1]) : "")})");

    private void OnElementCreated(object? sender, DesignElementCreatedEventArgs e)
    {
        _export = null;
        Log(e switch
        {
            { LandArea: { } land } => $"Created         land {land.Id} {land.Kind} {land.Points.Count} corners {land.Area:0} m²",
            { Pier: { } pier } => $"Created         pier {pier.Id} {pier.Type} {Fmt(pier.Length)}x{Fmt(pier.Width)} m {pier.BerthingSides}",
            _ => $"Created         {e.Berths.Count} berth(s) {string.Join(",", e.Berths.Select(s => s.Id))}",
        });
    }

    private void OnElementErased(object? sender, DesignElementErasedEventArgs e)
    {
        _export = null;
        Log($"Erased          {e.Element.GetType().Name} ({e.RemovedBerths.Count} berths)");
    }

    private void OnScaleLineDrawn(object? sender, ScaleLineDrawnEventArgs e) => Log($"ScaleLine       {Fmt(e.MeasuredLength)} m at the current scale");

    private void OnReferenceImageChanged(object? sender, ReferenceImageChangedEventArgs e) =>
        Log($"ReferenceImage  {e.Change} {e.MetersPerPixel:0.####} m/px center {Fmt(e.Center)}");

    // ---- Library events (raised from canvas input via JS interop, or from API calls) ----------

    private void OnBerthClicked(object? sender, BerthEventArgs e) =>
        Log($"BerthClicked     {e.BerthId} [{e.Status}] button={e.Button}{(e.IsDoubleClick ? " (double)" : "")} boat={e.Boat?.Name ?? "-"}");

    private void OnSelectionChanged(object? sender, SelectionChangedEventArgs e) => StateHasChanged();

    private void OnSelectionCleared(object? sender, EventArgs e) => Log("SelectionCleared");

    private void OnBerthHoverChanged(object? sender, BerthHoverEventArgs e)
    {
        _hoverText = e.Berth is null ? string.Empty : $"Hover: {e.Berth.DisplayName} ({e.Berth.Status.GetDisplayName()})";
        StateHasChanged();
    }

    private void OnBerthStatusChanged(object? sender, BerthStatusChangedEventArgs e) =>
        Log($"StatusChanged   {e.BerthId}: {e.OldStatus} -> {e.NewStatus} boat={e.NewBoat?.Name ?? "-"}");

    private void OnLayoutChanged(object? sender, LayoutChangedEventArgs e)
    {
        _stats = _marina.GetStatistics();
        Log($"LayoutChanged   {e.Kind} {e.LandAreaId} {e.PierId} {e.BerthId} {e.MultiBerthId}".Replace("  ", " ").TrimEnd());
    }

    /// <summary>The views changed (a pier came or went, the view was resized, a view was switched off): list them again.</summary>
    private void OnCameraPresetsChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);

    // ---- UI actions ----------------------------------------------------------------------------

    private void OnRendererReady(string description) => _rendererInfo = description;

    private void OnRendererError(string message) => _rendererInfo = "Renderer error: " + message;

    private string[] SelectedIds() => _marina.SelectedBerths.Select(s => s.Id).ToArray();

    private void SetSelectedStatus(BerthStatus status)
    {
        using (_marina.BeginUpdate())
        {
            foreach (var berth in _marina.SelectedBerths)
            {
                var boat = status == BerthStatus.Free ? null : berth.Boat ?? MockMarinaFactory.CreateBoatForBerth(berth, _rng);
                _marina.SetBerthStatus(berth.Id, status, boat);
            }
        }
    }

    private void FocusSelected() => _marina.FocusSelection(CameraAngle.TopDown);

    /// <summary>
    /// Selects every berth on the selected berth's pier, or every land berth on its land area (disabled ones are discarded),
    /// and frames them top-down.
    /// </summary>
    private void SelectWholePier()
    {
        if (_marina.SelectedBerth?.LandAreaId is { } landAreaId)
        {
            var onLand = _marina.SetSelection(_marina.GetBerthsByLandArea(landAreaId).Select(s => s.Id), focusCamera: true, CameraAngle.TopDown);
            Log($"SetSelection    {onLand.Count} selected on land area {landAreaId}; skipped: {onLand.Rejected.Count}");
            return;
        }

        var pierId = _marina.SelectedBerth?.PierId ?? _marina.GetPiers().FirstOrDefault()?.Id;
        if (pierId is null) return;

        var result = _marina.SetSelection(_marina.GetBerthsByPier(pierId).Select(s => s.Id), focusCamera: true, CameraAngle.TopDown);
        Log($"SetSelection    {result.Count} selected on pier {pierId}; skipped: " +
            (result.Rejected.Count == 0 ? "none" : string.Join(", ", result.Rejected.Select(r => $"{r.BerthId} ({r.Reason})"))));
    }

    private void ToggleFilter(ref bool field, ChangeEventArgs e)
    {
        field = e.Value is true;
        ApplyFilter();
    }

    private void ShowAll()
    {
        _showFree = _showOccupied = _showReserved = _showTemporarilyFree = true;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        var filter = BerthStatusFilter.None;
        if (_showFree) filter |= BerthStatusFilter.Free;
        if (_showOccupied) filter |= BerthStatusFilter.Occupied;
        if (_showReserved) filter |= BerthStatusFilter.Reserved;
        if (_showTemporarilyFree) filter |= BerthStatusFilter.TemporarilyFree;
        _marina.SetStatusFilter(filter);
        Log($"Filter          {filter}");
    }

    private void ApplyLabelMode(ChangeEventArgs e)
    {
        if (!Enum.TryParse<BerthLabelMode>(e.Value?.ToString(), out var mode)) return;
        _marina.BerthLabelMode = mode;
        Log($"BerthLabelMode   {mode}");
    }

    // An automatic view is listed by its key, which stays the same whatever the language or the pier's name; a saved
    // view by its name. The prefix keeps a saved view called "Overview" apart from the automatic one.
    private const string AutomaticPrefix = "auto:", SavedPrefix = "saved:";
    private const string OverviewValue = AutomaticPrefix + MarinaVisualizer.OverviewPresetName;

    private static string PresetValue(CameraPreset preset) =>
        preset.IsBuiltIn && preset.Key is { } key ? AutomaticPrefix + key : SavedPrefix + preset.Name;

    private void ApplyPreset(ChangeEventArgs e)
    {
        _selectedPreset = e.Value?.ToString() ?? OverviewValue;
        if (_selectedPreset.StartsWith(AutomaticPrefix, StringComparison.Ordinal))
        {
            _marina.ApplyBuiltInCameraPreset(_selectedPreset[AutomaticPrefix.Length..]);
        }
        else if (_selectedPreset.StartsWith(SavedPrefix, StringComparison.Ordinal))
        {
            _marina.ApplyCameraPreset(_selectedPreset[SavedPrefix.Length..]);
        }
    }

    private void ResetView()
    {
        _selectedPreset = OverviewValue;
        _marina.ResetCamera();
    }

    private void AddGuestBerth()
    {
        var berth = MockMarinaFactory.CreateGuestBerth(_marina, "D");
        if (berth is null)
        {
            Log("Pier D guest berths are full.");
            return;
        }

        _marina.AddBerth(berth);
        _marina.SelectBerth(berth.Id, focusCamera: true);
    }

    private void RemoveSelected()
    {
        using (_marina.BeginUpdate())
        {
            foreach (var id in SelectedIds()) _marina.RemoveBerth(id);
        }
    }

    private void ReleaseSelectedBerth()
    {
        var multiBerthIds = _marina.SelectedBerths.Select(s => s.MultiBerthId).OfType<string>().Distinct().ToList();
        if (multiBerthIds.Count == 0) Log("Select a berth of a multi-berth first.");
        foreach (var id in multiBerthIds) _marina.ReleaseMultiBerth(id);
    }

    private void RunBatch()
    {
        var updates = MockMarinaFactory.CreateRandomActivity(_marina.GetBerths(), _rng, 15);
        var result = _marina.BatchUpdate(updates.Append(BerthUpdate.Free("DOES-NOT-EXIST")));
        Log($"BatchUpdate     applied={result.AppliedCount} errors={result.Errors.Count} ({string.Join("; ", result.Errors.Select(x => x.BerthId))})");
    }

    private void ReloadLayout()
    {
        _selectedPreset = OverviewValue;
        _document = null;
        _marina.InitializeLayout(MockMarinaFactory.CreateSampleMarina(_rng.Next()));
    }

    private void ToggleReservedColor()
    {
        var purple = new ColorRgba(0.6f, 0.3f, 0.9f);
        _marina.SetStatusColor(BerthStatus.Reserved,
            _marina.GetStatusColor(BerthStatus.Reserved) == purple ? StatusColorScheme.DefaultReserved : purple);
    }

    private string SelectionDetails()
    {
        if (_marina.SelectedBerth is not { } berth) return "Click a berth or boat in the 3D view.\nCtrl+click or Shift+click to select several, right-click for actions.";

        var sb = new StringBuilder();
        if (_marina.IsMultiSelection)
        {
            sb.AppendLine($"{_marina.SelectedBerths.Count} berths selected (primary last):");
            foreach (var s in _marina.SelectedBerths) sb.AppendLine($"  {s.DisplayName,-12} {s.Status.GetDisplayName(),-16} {s.Boat?.Name}");
            return sb.ToString();
        }

        sb.AppendLine($"Berth:    {berth.DisplayName} ({berth.Id})");
        if (berth.LandAreaId is { } landAreaId)
        {
            sb.AppendLine($"Land:    {_marina.GetLandArea(landAreaId)?.DisplayName ?? landAreaId} (stored ashore)");
        }
        else if (berth.PierId is { } pierId)
        {
            var pier = _marina.GetPier(pierId);
            var sides = pier?.BerthingSides is PierSides.Left or PierSides.Right ? ", single-sided" : "";
            sb.AppendLine($"Pier:    {pier?.Name} ({(pier is null ? "?" : Pier.GetDisplayName(pier.Type))}{sides})");
        }

        sb.AppendLine($"Status:  {berth.Status.GetDisplayName()}");
        sb.AppendLine($"Size:    {berth.Length:0.0} m x {berth.Width:0.0} m, draft {berth.MaxDraft?.ToString("0.0") ?? "?"} m");
        if (berth.Boat is { } boat)
        {
            sb.AppendLine($"Boat:    {boat.Name} ({boat.TypeDisplayName})");
            sb.AppendLine($"         {boat.LengthMeters:0.0} m x {boat.BeamMeters:0.0} m, {boat.RegistrationNumber}");
            sb.AppendLine($"Owner:   {boat.OwnerName}");
            if (boat.ExpectedArrival is { } eta) sb.AppendLine($"ETA:     {eta:g}");
        }

        if (berth.MultiBerthId is { } multiBerthId) sb.AppendLine($"Berth:   {multiBerthId} ({_marina.GetMultiBerth(multiBerthId)?.Style})");
        if (berth.IsReadOnly) sb.AppendLine("Flags:   read-only");
        foreach (var (key, value) in berth.Metadata) sb.AppendLine($"{key,-8} {value}");
        foreach (var (key, value) in berth.ExternalData) sb.AppendLine($"ext:{key} = {value}");
        return sb.ToString();
    }

    private void Log(string message)
    {
        _log.AddFirst($"{DateTime.Now:HH:mm:ss}  {message}");
        while (_log.Count > 200) _log.RemoveLast();
        StateHasChanged();
    }
}
